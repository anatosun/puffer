<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.anatosun.puffer</id>
  <name>Puffer</name>
  <summary>Play music from your Subsonic or Navidrome server</summary>
  <developer id="io.github.anatosun">
    <name>anatosun</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <launchable type="desktop-id">io.github.anatosun.puffer.desktop</launchable>
  <url type="homepage">https://github.com/anatosun/puffer</url>
  <url type="bugtracker">https://github.com/anatosun/puffer/issues</url>
  <url type="vcs-browser">https://github.com/anatosun/puffer</url>
  <description>
    <p>A music player for your own server. Puffer works with any Subsonic or OpenSubsonic server, such as Navidrome, Gonic or Airsonic-Advanced.</p>
    <ul>
      <li>A full-screen now-playing view coloured by the album artwork</li>
      <li>Downloads of songs, albums, playlists and artists for offline listening; downloaded playlists stay in sync</li>
      <li>A downloaded-only view, and an offline mode that browses the downloaded library</li>
      <li>Download quality, original or transcoded</li>
      <li>Playback on speakers through Music Assistant, in sync across rooms</li>
    </ul>
    <p>Puffer connects only to the servers you configure. It has no advertising and no tracking.</p>
  </description>
