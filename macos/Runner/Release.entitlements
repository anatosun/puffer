<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Outside the sandbox, as the app is distributed outside the Mac App Store: the library folder a person picks stays writable after a restart, and the keychain needs no team entitlement. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
